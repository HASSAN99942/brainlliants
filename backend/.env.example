SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=brailliants
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
REDIS_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
GEMINI_API_KEY=your-gemini-api-key
CAMPAY_USERNAME=your-campay-username
CAMPAY_PASSWORD=your-campay-password
CAMPAY_BASE_URL=https://demo.campay.net/api/
FCM_SERVER_KEY=your-fcm-server-key

# Feature flags. While PAYMENTS_ENABLED=false the paywall is hidden in the app
# and the freemium caps (20 AI queries, 3 downloads per exam type) are lifted, so
# nobody hits a wall they cannot pass. Turn this on at the same time as
# EXPO_PUBLIC_FEATURE_PAYMENTS in mobile-rn/.env.
PAYMENTS_ENABLED=false

# Local dev only: set to True to use the PostgreSQL config from base.py
# instead of the SQLite fallback in config/settings/development.py.
USE_POSTGRES=False

# ---------------------------------------------------------------------------
# Production / Render only — set these in the Render dashboard, never in a file.
# ---------------------------------------------------------------------------
# DJANGO_SETTINGS_MODULE=config.settings.production
#
# One connection string each, supplied by the Render add-ons. When DATABASE_URL
# is present it overrides the DB_* values above; likewise REDIS_URL overrides
# REDIS_HOST and also becomes the Celery broker.
# DATABASE_URL=postgres://user:pass@host/dbname
# REDIS_URL=rediss://red-xxxx:password@host:6379
#
# Bootstrap the super admin on deploy (apps/accounts/.../create_admin.py).
# Idempotent: re-running never duplicates the account or resets its password.
# DJANGO_SUPERUSER_EMAIL=you@brailliants.cm
# DJANGO_SUPERUSER_PASSWORD=a-strong-password
# DJANGO_SUPERUSER_FIRST_NAME=Your
# DJANGO_SUPERUSER_LAST_NAME=Name
#
# Optional overrides:
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600      # raise to 31536000 once you are sure
# DB_SSL_REQUIRE=True
